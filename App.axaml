<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RomRebuilderUI.ViewModels"
             xmlns:v="using:RomRebuilderUI.Views"
             x:Class="RomRebuilderUI.App"
             RequestedThemeVariant="Dark">

    <!-- Explicitly map ViewModels to their corresponding Views -->
    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:MameScannerViewModel}">
            <v:MameScannerView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:MameWorkflowViewModel}">
            <v:MameWorkflowView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:ConsoleWorkflowViewModel}">
            <v:ConsoleWorkflowView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:InspectorViewModel}">
            <v:InspectorView/>
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
            <v:MonitorView/>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme/>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
    </Application.Styles>
</Application>
