>>>>>>> 138a04b0330dce3d0e86e9d5e3aefda4f24bc5a2
>>>>>>> ce1718f54edc81cfff62e2342fbad5847bd38b0c
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DIVIDER SEPARATOR -->
            <Rectangle Grid.Column="1" Fill="#33808080" Width="1" VerticalAlignment="Stretch"/>

            <!-- RIGHT COLUMN: Collection Dashboard & Audit Results -->
            <Border Grid.Column="2" BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Background="#161616" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *, 120, Auto">
                    
                    <!-- 1. TOP SECTION: Health Overview -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Collection Health Dashboard" FontSize="15" FontWeight="Bold" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding CollectionHealthText}" FontSize="14" FontWeight="SemiBold" Foreground="LightGreen" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar Value="{Binding CollectionHealthPercentage}" Maximum="100" Height="8" Foreground="LightGreen"/>
                        <UniformGrid Columns="4" Margin="0,4,0,0">
                            <TextBlock Text="{Binding MatchedCount, StringFormat='Complete: {0}'}" Foreground="LightGreen" FontSize="11"/>
                            <TextBlock Text="{Binding FilteredDuplicatesCount, StringFormat='Incomplete: {0}'}" Foreground="Yellow" FontSize="11"/>
                            <TextBlock Text="{Binding MissingCount, StringFormat='Missing: {0}'}" Foreground="Red" FontSize="11"/>
                            <TextBlock Text="{Binding UnknownCount, StringFormat='Unknown: {0}'}" Foreground="MediumPurple" FontSize="11"/>
                        </UniformGrid>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- 2. MIDDLE SECTION: Sets Explorer with Filter Dropdown -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *" Margin="0,0,0,8">
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Sets Explorer" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <TextBlock Text="Filter:" FontSize="11" Foreground="DarkGray" VerticalAlignment="Center"/>
                                <ComboBox Width="120" FontSize="11" 
                                          ItemsSource="{Binding StatusFilterOptions}" 
                                          SelectedItem="{Binding SelectedStatusFilter}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding ConsoleAuditItems}" 
                                  SelectedItem="{Binding SelectedAuditItem}"
                                  AutoGenerateColumns="False" 
                                  IsReadOnly="True"
                                  CanUserSortColumns="True" 
                                  CanUserResizeColumns="True"
                                  HorizontalScrollBarVisibility="Auto"
                                  Background="#1E1E1E"
                                  Foreground="White">
                            <DataGrid.Styles>
                                <Style Selector="DataGridCell">
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </DataGrid.Styles>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Game / System Name" Binding="{Binding Name}" Width="*"/>
                                
                                <!-- Color-coded Status Column -->
                                <DataGridTemplateColumn Header="Status" Width="95" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding StatusColor}" 
                                                       VerticalAlignment="Center" 
                                                       Margin="12,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="Auto"/>
                                <DataGridTextColumn Header="Missing Files" Binding="{Binding RomCountSummary}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 3. BOTTOM SECTION: Missing Files Drill-Down Inspector -->
                    <Border Grid.Row="3" BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Background="#121212" Padding="8" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="{Binding SelectedAuditItem.Name, StringFormat='Missing Files for: {0}'}" FontWeight="SemiBold" FontSize="11" Foreground="DarkGray" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedAuditItem.MissingFiles}" Background="Transparent" BorderThickness="0" FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="IndianRed"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 4. ACTIONS: Export Missing List -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Export Missing List..." Command="{Binding ExportMissingListCommand}" Width="160" IsEnabled="{Binding HasAuditItems}"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

        <!-- PLEASE WAIT OVERLAY -->
        <Border Background="#A0000000" IsVisible="{Binding IsWorking}" ZIndex="999">
            <Border HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Background="#222222" 
                    Padding="32,24" 
                    CornerRadius="8" 
                    BorderBrush="#44808080" 
                    BorderThickness="1">
                <StackPanel Spacing="14">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="6" Foreground="DodgerBlue"/>
                    <TextBlock Text="Please wait, scanning source ROM files..." FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="DarkGray" HorizontalAlignment="Center" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
