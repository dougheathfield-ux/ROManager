                            <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="Gray" HorizontalAlignment="Left"/>
                            <TextBlock Text="{Binding RebuildElapsedTime, StringFormat='Elapsed: {0}'}" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                        </Grid>
