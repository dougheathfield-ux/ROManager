<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RomRebuilderUI.ViewModels"
             xmlns:models="using:RomRebuilderUI.Models"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="RomRebuilderUI.Views.MameScannerView"
             x:DataType="vm:MameScannerViewModel"
             Background="#1E1E1E">

    <Grid>
        <Grid ColumnDefinitions="460, 12, *" Margin="16">
            
            <!-- LEFT COLUMN: Scanner Controls & Configuration -->
            <Grid Grid.Column="0" RowDefinitions="*, Auto">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="14" Margin="0,0,4,0">
                        <!-- Header -->
                        <TextBlock Text="MAME ROM Scanner &amp; Auditor" FontSize="18" FontWeight="Bold"/>
                        <Separator/>

                        <!-- 1. DAT File Selection -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="1. MAME DAT / XML File" FontWeight="SemiBold" FontSize="13"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Text="{Binding MameDatPath}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="Browse..." Width="80" Click="OnBrowseDatClick"/>
                            </Grid>
                        </StackPanel>

                        <!-- 2. Source Directories -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="2. Source ROM Directories to Audit" FontWeight="SemiBold" FontSize="13"/>
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                                <ListBox Grid.Column="0" Height="85" ItemsSource="{Binding MameSourceDirs}" SelectedItem="{Binding SelectedMameSourceDir}"/>
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                    <Button Content="Add..." Width="90" Click="OnAddSourceClick"/>
                                    <Button Content="Remove" Command="{Binding RemoveSourceCommand}" CommandParameter="{Binding SelectedMameSourceDir}" Width="90"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Separator Margin="0,4,0,4"/>

                        <!-- SCANNER & AUDITOR OPTIONS -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Scanner &amp; Auditor Options" FontWeight="SemiBold" FontSize="13"/>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2" Spacing="8">
                                <TextBlock Text="Structure Context:" VerticalAlignment="Center" FontSize="12"/>
                                <ComboBox Width="130" FontSize="11" 
                                          ItemsSource="{Binding RebuildModeOptions}" 
                                          SelectedItem="{Binding SelectedRebuildMode}"/>
                            </StackPanel>

                            <!-- Target Selection -->
                            <TextBlock Text="Target Selection:" FontSize="11" Foreground="DarkGray" Margin="0,4,0,0"/>
                            <UniformGrid Columns="2" Margin="12,0,0,2">
                                <CheckBox Content="ROMs" IsChecked="{Binding AuditRoms}" FontSize="11"/>
                                <CheckBox Content="Disks (CHD)" IsChecked="{Binding AuditDisks}" FontSize="11"/>
                                <CheckBox Content="Samples" IsChecked="{Binding AuditSamples}" FontSize="11"/>
                                <CheckBox Content="BIOS / Extras" IsChecked="{Binding AuditBios}" FontSize="11"/>
                            </UniformGrid>

                            <!-- Deep Verification Flags -->
                            <TextBlock Text="Deep Verification Flags:" FontSize="11" Foreground="DarkGray" Margin="0,4,0,0"/>
                            <CheckBox Content="Decompress &amp; check internal checksums" IsChecked="{Binding DecompressAndVerify}" FontSize="11" Margin="12,0,0,0"/>
                            <CheckBox Content="Deep CHD block integrity check (MD5/SHA1)" IsChecked="{Binding ChdDeepVerify}" FontSize="11" Margin="12,0,0,0"/>

                            <!-- Fix & Cleanup Options -->
                            <TextBlock Text="Fix &amp; Cleanup Actions:" FontSize="11" Foreground="DarkGray" Margin="0,4,0,0"/>
                            <CheckBox Content="Fix Missing (Pull from Add-Paths)" IsChecked="{Binding FixMissingFiles}" FontSize="11" Margin="12,0,0,0"/>
                            <CheckBox Content="Fix Unneeded / Bad (Move to backup)" IsChecked="{Binding FixUnneededFiles}" FontSize="11" Margin="12,0,0,0"/>
                        </StackPanel>

                        <Separator Margin="0,4,0,4"/>

                        <!-- Operations -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Operations" FontWeight="SemiBold" FontSize="13"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Run Audit" Command="{Binding AuditMameCommand}" IsEnabled="{Binding !IsWorking}" Width="110"/>
                                <Button Content="Clear Scan" Command="{Binding ClearScanCommand}" IsEnabled="{Binding !IsWorking}" Width="90"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Progress Bar & Status Text -->
                <Border Grid.Row="1" Padding="0, 8, 0, 0">
                    <StackPanel Spacing="4">
                        <ProgressBar Value="{Binding ProgressValue}" 
                                     Maximum="{Binding ProgressMaximum}" 
                                     IsIndeterminate="{Binding IsIndeterminate}" 
                                     Height="5"/>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="Gray"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- DIVIDER -->
            <Rectangle Grid.Column="1" Fill="#33808080" Width="1" VerticalAlignment="Stretch"/>

            <!-- RIGHT COLUMN: Audit Results & Sets Explorer -->
            <Border Grid.Column="2" BorderBrush="#33808080" BorderThickness="1" CornerRadius="6" Background="#161616" Padding="12">
                <Grid RowDefinitions="Auto, Auto, *, 120, Auto">
                    
                    <!-- 1. Health Overview -->
                    <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,10">
                        <Grid>
                            <TextBlock Text="Audit Health Dashboard" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding MameAuditItems.Count, StringFormat='Scanned Sets: {0}'}" FontSize="13" Foreground="LightGreen" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar Value="0" Maximum="100" Height="8" Foreground="LightGreen"/>
                    </StackPanel>

                    <Separator Grid.Row="1" Margin="0,0,0,8"/>

                    <!-- 2. Sets Explorer -->
                    <Grid Grid.Row="2" RowDefinitions="Auto, *">
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Sets Explorer" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <TextBlock Text="Sort:" FontSize="11" Foreground="DarkGray" VerticalAlignment="Center"/>
                                <!-- Sort ComboBox made 10 pixels longer (120 -> 130) -->
                                <ComboBox Width="130" FontSize="11" 
                                          ItemsSource="{Binding SortOptions}" 
                                          SelectedItem="{Binding SelectedSortOption}"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1" 
                                  ItemsSource="{Binding MameAuditItems}" 
                                  SelectedItem="{Binding SelectedAuditItem}"
                                  AutoGenerateColumns="False" 
                                  CanUserResizeColumns="True"
                                  CanUserReorderColumns="True"
                                  IsReadOnly="True"
                                  Background="#1E1E1E"
                                  Foreground="White">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/>
                                <DataGridTextColumn Header="Machine Name" Binding="{Binding Name}" Width="1.5*"/>
                                
                                <!-- Color-coded Status Column with SortMemberPath enabled -->
                                <DataGridTemplateColumn Header="Status" Width="95" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:MachineAuditItem">
                                            <TextBlock Text="{Binding Status}" 
                                                       Foreground="{Binding StatusColor}" 
                                                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Files" Binding="{Binding RomCountSummary}" Width="Auto"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- 3. Missing Files Drill-Down -->
                    <Border Grid.Row="3" BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Background="#121212" Padding="8" Margin="0,8,0,0">
                        <Grid RowDefinitions="Auto, *">
                            <TextBlock Grid.Row="0" Text="{Binding SelectedMachineNameDisplay}" FontWeight="SemiBold" FontSize="11" Foreground="DarkGray" Margin="0,0,0,4"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedMissingFiles}" Background="Transparent" BorderThickness="0" FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="IndianRed"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 4. Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Export Missing List..." Width="160" IsEnabled="{Binding HasAuditItems}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- PLEASE WAIT OVERLAY -->
        <Border Background="#A0000000" IsVisible="{Binding IsWorking}" ZIndex="999">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" Padding="32,24" CornerRadius="8" BorderBrush="#44808080" BorderThickness="1">
                <StackPanel Spacing="14">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="6" Foreground="DodgerBlue"/>
                    <TextBlock Text="Auditing MAME sets..." FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="DarkGray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
