<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RomRebuilderUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="RomRebuilderUI.Views.MameWorkflowView"
             x:DataType="vm:MameWorkflowViewModel"
             Background="#1E1E1E">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
            <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
                
                <!-- Header -->
                <StackPanel Spacing="4">
                    <TextBlock Text="MAME Arcade Rebuilder" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Engine-level sorting, restructuring, and compression engine inspired by ClrMamePro." FontSize="12" Foreground="DarkGray"/>
                </StackPanel>
                <Separator/>

                <!-- 1. PATHS CONFIGURATION -->
                <StackPanel Spacing="8">
                    <TextBlock Text="1. Paths &amp; Directories" FontWeight="SemiBold" FontSize="14" Foreground="LightBlue"/>
                    
                    <!-- DAT File -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="MAME DAT / XML File" FontSize="12"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding MameDatPath}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Browse..." Width="90" Click="OnBrowseDatClick"/>
                        </Grid>
                    </StackPanel>

                    <!-- Source Directories -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="Primary Source ROM Directories" FontSize="12"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <ListBox Grid.Column="0" Height="75" ItemsSource="{Binding SourceDirs}" SelectedItem="{Binding SelectedSourceDir}"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                <Button Content="Add..." Width="90" Click="OnAddSourceClick"/>
                                <Button Content="Remove" Command="{Binding RemoveSourceCommand}" CommandParameter="{Binding SelectedSourceDir}" Width="90"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Add-Paths -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="Auxiliary Add-Paths (Secondary files fallback)" FontSize="12"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <ListBox Grid.Column="0" Height="65" ItemsSource="{Binding AddPaths}" SelectedItem="{Binding SelectedAddPath}"/>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Top">
                                <Button Content="Add..." Width="90" Click="OnAddAddPathClick"/>
                                <Button Content="Remove" Command="{Binding RemoveAddPathCommand}" CommandParameter="{Binding SelectedAddPath}" Width="90"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Output Directory -->
                    <StackPanel Spacing="3">
                        <TextBlock Text="Output Destination Directory" FontSize="12"/>
                        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0" Text="{Binding OutputDirectory}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Browse..." Width="90" Click="OnBrowseOutputClick"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <Separator/>

                <!-- 2. ARCHITECTURE & FORMAT -->
                <StackPanel Spacing="8">
                    <TextBlock Text="2. Architecture &amp; Output Format" FontWeight="SemiBold" FontSize="14" Foreground="LightBlue"/>
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="16">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Rebuild Structure Mode:" FontSize="12"/>
                            <ComboBox HorizontalAlignment="Stretch" 
                                      ItemsSource="{Binding RebuildModeOptions}" 
                                      SelectedItem="{Binding SelectedRebuildMode}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Compression Format:" FontSize="12"/>
                            <ComboBox HorizontalAlignment="Stretch" 
                                      ItemsSource="{Binding CompressionFormatOptions}" 
                                      SelectedItem="{Binding SelectedCompressionFormat}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <Separator/>

                <!-- 3. ADVANCED REBUILDER ENGINE OPTIONS -->
                <StackPanel Spacing="8">
                    <TextBlock Text="3. Advanced Rebuilder Engine Toggles" FontWeight="SemiBold" FontSize="14" Foreground="LightBlue"/>
                    
                    <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="6" Margin="0,0,8,0">
                            <CheckBox Content="Separate BIOS sets into dedicated archives" IsChecked="{Binding SeparateBiosSets}" FontSize="12"/>
                            <CheckBox Content="Recompress files (forces fresh compression ratio)" IsChecked="{Binding RecompressFiles}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <CheckBox Content="Remove successfully matched source files" IsChecked="{Binding RemoveMatchedSourceFiles}" FontSize="12"/>
                            <CheckBox Content="Verify deep hashes on match (prevent CRC collisions)" IsChecked="{Binding VerifyHashesOnMatch}" FontSize="12"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <Separator/>

                <!-- 4. EXECUTION & PROGRESS -->
                <StackPanel Spacing="8">
                    <Button Content="Run Arcade Rebuild" 
                            Command="{Binding RunRebuildCommand}" 
                            IsEnabled="{Binding !IsWorking}" 
                            HorizontalAlignment="Left" 
                            Width="180" 
                            Height="36"/>

                    <ProgressBar Value="{Binding ProgressValue}" 
                                 Maximum="{Binding ProgressMaximum}" 
                                 IsIndeterminate="{Binding IsIndeterminate}" 
                                 Height="6"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="DarkGray"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- PLEASE WAIT OVERLAY -->
        <Border Background="#A0000000" IsVisible="{Binding IsWorking}" ZIndex="999">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="#222222" Padding="32,24" CornerRadius="8" BorderBrush="#44808080" BorderThickness="1">
                <StackPanel Spacing="14">
                    <ProgressBar IsIndeterminate="True" Width="240" Height="6" Foreground="DodgerBlue"/>
                    <TextBlock Text="Processing MAME Arcade Rebuild..." FontSize="14" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="DarkGray" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
