<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:RomRebuilderUI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="RomRebuilderUI.Views.MonitorView"
             x:DataType="vm:MonitorViewModel">

    <Grid RowDefinitions="Auto, *, Auto" Margin="16" RowSpacing="12">
        <!-- Header & Control Buttons -->
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="Batch Execution &amp; Live Monitor" FontSize="20" FontWeight="Bold"/>
            <Separator/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Refresh Logs" Command="{Binding RefreshLogsCommand}" Width="120"/>
                <Button Content="Clear Log File" Command="{Binding ClearLogCommand}" Width="120"/>
            </StackPanel>
        </StackPanel>

        <!-- Terminal-style Log Viewer Area -->
        <Border Grid.Row="1" BorderBrush="#33808080" BorderThickness="1" CornerRadius="4" Background="#1E1E1E">
            <ScrollViewer>
                <TextBox Text="{Binding LogContent}" AcceptsReturn="True" IsReadOnly="True" 
                         Background="Transparent" Foreground="#DCDCDC" FontFamily="Consolas, monospace"
                         BorderThickness="0" Padding="8"/>
            </ScrollViewer>
        </Border>

        <!-- Bottom Status Bar -->
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="Gray"/>
    </Grid>
</UserControl>
